[Unit]
Description=Meeko shell (quickshell)
After=graphical-session.target

[Service]
# Forward compositor session vars from the user manager into the unit.
# The manager's env is populated by the host session (Hyprland exec-once
# or manual `systemctl --user import-environment`); PassEnvironment= reads
# the manager's env at unit activation time.
#
# PassEnvironment= is the correct [Service] directive. ImportEnvironment= is not
# valid in either section — systemd prints "Unknown key … ignoring" and carries on,
# and `systemd-analyze verify` still exits 0, so the mistake is silent.
PassEnvironment=WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR
ExecStart=/usr/bin/qs
Restart=on-failure
RestartSec=1s
MemoryHigh=350M
MemoryMax=430M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
